{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "node e2e/portal-smoke.cjs",
    "verify:live": "node e2e/verify-login-loop-and-simple-pos.cjs",
    "verify:links": "node e2e/verify-navigation-link-health.cjs",
    "verify:controls": "node e2e/verify-interactive-control-labels.cjs",
    "verify:actions": "node e2e/verify-safe-action-buttons.cjs",
    "verify:feature-coverage": "node e2e/verify-feature-action-coverage.cjs",
    "verify:route-actions": "node e2e/verify-route-action-inventory.cjs",
    "verify:action-hygiene": "node e2e/verify-action-placeholder-hygiene.cjs",
    "verify:action-feedback": "node e2e/verify-action-feedback-hygiene.cjs",
    "verify:audit:preflight": "node e2e/verify-audit-env.cjs",
    "verify:audit:surface": "npm run verify:links && npm run verify:controls && npm run verify:actions",
    "verify:audit:inventory": "npm run verify:feature-coverage && npm run verify:route-actions && npm run verify:action-hygiene",
    "verify:role-gates": "node e2e/verify-role-gates.cjs",
    "verify:landing": "node e2e/verify-landing-page.cjs",
    "verify:portal-shell": "node e2e/verify-portal-shell.cjs",
    "verify:store-profile": "node e2e/verify-store-profile.cjs",
    "verify:scheduled-orders": "node e2e/verify-scheduled-orders.cjs",
    "verify:audit:live": "npm run verify:action-feedback && npm run verify:portal-shell && npm run verify:landing && npm run verify:store-profile && npm run verify:scheduled-orders && npm run verify:role-gates && node e2e/verify-restaurant-ready-audit.cjs && npm run verify:roadmap",
    "verify:audit": "npm run verify:audit:preflight && npm run verify:audit:surface && npm run verify:audit:inventory && npm run verify:audit:live",
    "verify:deployment": "node e2e/verify-live-deployment-proof.cjs",
    "verify:ai-insights": "node e2e/verify-ai-insights-feedback.cjs",
    "verify:breakeven-setup": "node e2e/verify-breakeven-setup-feedback.cjs",
    "verify:inventory-scan": "node e2e/verify-inventory-scan-feedback.cjs",
    "verify:invoice-archive": "node e2e/verify-invoice-archive-actions.cjs",
    "verify:recipe-intelligence": "node e2e/verify-recipe-intelligence-actions.cjs",
    "verify:vendor-waste": "node e2e/verify-vendor-waste-operations.cjs",
    "verify:text-hygiene": "node e2e/verify-source-text-hygiene.cjs",
    "verify:roadmap": "node e2e/verify-roadmap-command-board.cjs",
    "verify:quality:static": "npm run typecheck && npm run build && npm run verify:audit:inventory",
    "verify:quality": "npm run typecheck && npm run build && npm run verify:audit"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
