# Copy this file to backend/.env.deploy.local and fill in real values.
# .env.deploy.local is ignored by git; this example is safe to commit.
# The backend never reads this file by itself: the deploy host sets the same
# names as environment variables. It exists so `python check_database_uri.py`
# and `python -m alembic upgrade head` can be run from this machine.
#
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production

# Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
# Keep +psycopg2 in the scheme and ?sslmode=require at the end.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Secrets: long random strings, different from each other.
AUTH_SECRET_KEY=
PIZZA_BLITZ_SESSION_SECRET=

# The master login used by the portal.
RESTAURANT_ADMIN_ID=admin
RESTAURANT_ADMIN_PASSWORD=
PIZZA_BLITZ_ADMIN_ID=admin
PIZZA_BLITZ_ADMIN_PASSWORD=

# Public addresses. Replace with the real deployed origins before launch.
BACKEND_CORS_ORIGINS=https://pizzablitz.example
PIZZA_BLITZ_PUBLIC_URL=https://pizzablitz.example
PAYMENT_RETURN_URL=https://pizzablitz.example/account
PIZZA_BLITZ_SITE_URL=https://pizzablitz.example
RESTAURANT_TIMEZONE=Asia/Kolkata

# Frontend values, for the hosting dashboard and frontend/.env.production:
# NEXT_PUBLIC_API_URL=https://<backend-host>
# PIZZA_BLITZ_API_URL=https://<backend-host>
# PIZZA_BLITZ_SITE_URL=https://<frontend-host>
# PIZZA_BLITZ_ADMIN_ID=admin
# PIZZA_BLITZ_ADMIN_PASSWORD=<same as RESTAURANT_ADMIN_PASSWORD>
# PIZZA_BLITZ_SESSION_SECRET=<same as PIZZA_BLITZ_SESSION_SECRET>
