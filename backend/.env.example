SQLALCHEMY_DATABASE_URI=sqlite:///:memory:
# Supabase production format:
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
ENVIRONMENT=development
# Calendar timezone for sales days, orders, and promotions.
RESTAURANT_TIMEZONE=Asia/Kolkata
# Per-instance throttle for sensitive public endpoints (login proof, order
# creation, payment verification). Add a shared edge limiter when scaling out.
RATE_LIMIT_ENABLED=true
PIZZA_BLITZ_BOOTSTRAP_ON_STARTUP=true
PIZZA_BLITZ_SCHEDULER_ENABLED=true
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# Set to true only when a Google Sheet was linked once from Settings and the
# daily background refresh should keep re-importing it.
SHEET_AUTO_SYNC_ENABLED=false
RESTAURANT_ADMIN_ID=ktej255@gmail.com
RESTAURANT_ADMIN_PASSWORD=change-me
PIZZA_BLITZ_ADMIN_ID=ktej255@gmail.com
PIZZA_BLITZ_ADMIN_NAME=Tej Bahadur
PIZZA_BLITZ_ADMIN_PASSWORD=change-me
AUTH_SECRET_KEY=change-this-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=480
CUSTOMER_TOKEN_EXPIRE_MINUTES=43200
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=INR
PAYMENT_RETURN_URL=http://127.0.0.1:3011/account
PIZZA_BLITZ_PUBLIC_URL=http://127.0.0.1:3011
PIZZA_BLITZ_PUBLIC_API_PREFIX=/server
# Menu image storage (default backend/media); mount a persistent volume in production.
MEDIA_ROOT=
# Private resumes and offer letters (default backend/private_media); never statically served.
PRIVATE_MEDIA_ROOT=
# Public media storage: local (default) or s3 for an S3-compatible bucket + CDN.
MEDIA_STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=
S3_ACL=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_BASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
CAMPAIGN_SEND_ENABLED=false
CAMPAIGN_DEFAULT_COUNTRY_CODE=91
# Transactional order updates (sms|whatsapp|email|console).
ORDER_NOTIFICATIONS_ENABLED=false
ORDER_NOTIFICATION_CHANNEL=sms
# Customer login OTP delivery (sms|whatsapp|console) and lifetime.
CUSTOMER_OTP_CHANNEL=console
CUSTOMER_OTP_TTL_SECONDS=300
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
SOCIAL_PUBLISH_ENABLED=false
META_GRAPH_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
ADS_LAUNCH_ENABLED=false
META_AD_ACCOUNT_ID=
META_AD_ACCESS_TOKEN=
