{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "backend",
      "entrypoint": "main.py",
      "rewrites": [
        {
          "source": "/server/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "web",
          "format": "url",
          "env": "WEB_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/server(/.*)?",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "build": {
    "env": {
      "NEXT_PUBLIC_WEB_URL": "/",
      "NEXT_PUBLIC_API_URL": "/server"
    }
  }
}
